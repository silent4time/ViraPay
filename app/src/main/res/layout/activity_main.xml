<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- لوگوی ویراپی -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/virapay_logo"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="درگاه هوشمند ویراپی"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A202C"
            android:layout_marginBottom="24dp" />

        <!-- تنظیمات اتصال -->
        <EditText
            android:id="@+id/etApiId"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="شناسه تلگرام (Telegram API ID)"
            android:inputType="number"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etApiHash"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="کد امنیتی (API Hash)"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="شماره موبایل (+98...)"
            android:inputType="phone"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etCardAndBank"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="5041721205119325:ResalatBank"
            android:hint="شماره کارت:نام بانک"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etBotUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="silentping_vpn_bot"
            android:hint="یوزرنیم ربات تلگرام"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- دکمه‌های کنترل -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🚀 روشن کردن درگاه خودکار"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2B6CB0"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="⏹ خاموش کردن درگاه"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E53E3E"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- گزارشات زنده -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="گزارشات تراکنش‌ها و تاییدها:"
            android:textStyle="bold"
            android:textColor="#4A5568"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#EDF2F7"
            android:padding="12dp"
            android:textColor="#2D3748"
            android:textSize="12sp"
            android:scrollbars="vertical"
            android:text="سیستم آماده راه‌اندازی است...\n"/>

    </LinearLayout>
</ScrollView>
